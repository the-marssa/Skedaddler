# перезаписываем .gitignore
@"
# --- Unity ---
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log
/[Mm]emoryCaptures/
/[Rr]ecordings/

# IDE / инструменты
.vs/
.gradle/
.consulo/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.DotSettings.user

# Крэши/отчёты
sysinfo.txt
mono_crash.*

# Сборки/пакеты
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Addressables (дефолтные)
 /ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting (автоген)
 /[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
 /[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
 /[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
 /[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Тестовые автосцены
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# НЕ игнорировать .meta у файлов, которые в репозитории
!*.meta
"@ | Set-Content -Encoding UTF8 .gitignore

# Настроим Git LFS (если установлен)
git lfs install 2>$null
git lfs track "*.png" "*.jpg" "*.jpeg" "*.tga" "*.psd" "*.tif" "*.tiff" "*.exr" "*.hdr"
git lfs track "*.wav" "*.mp3" "*.ogg"
git lfs track "*.fbx" "*.blend" "*.obj" "*.glb" "*.gltf"
git lfs track "*.mp4" "*.mov"
git add .gitattributes

# Очистим индекс и применим игнор
git rm -r --cached .
git add .
git commit -m "Apply Unity .gitignore and enable Git LFS"
Write-Host "Готово. Проверь список изменений в Sourcetree."
