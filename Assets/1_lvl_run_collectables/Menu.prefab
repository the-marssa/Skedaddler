  m_text: "\u0417\u0440\u043E\u0431\u0438\u043C\u043E \u0432\u0438\u0433\u043B\u044F\u0434,
    \u0449\u043E \u0442\u0443\u0442 \u0454 \u043A\u0440\u0443\u0442\u0456 \u0441\u043A\u0456\u043D\u0438,
    \u0442\u0438\u043F\u0443\n\u0448\u043C\u043E\u0442 \u043A\u0443\u0440\u044C\u0435\u0440\u0430
    \u0413\u043B\u043E\u0432\u043E, \n\u0444\u043E\u0440\u043C\u0430 \u041D\u043E\u0432\u043E\u0457
    \u041F\u043E\u0448\u0442\u0438, \n\u043B\u0430\u043A\u0448\u0435\u0440\u0456
    \u0448\u043C\u043E\u0442 \u043A\u0440\u0438\u043F\u0442\u0430\u043D\u0430\n\n\u0410
    \u043D\u0438\u0436\u0447\u0435 \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u0434\u0438\u0432\u0438\u0442\u0438\u0441\u044F
    3 \u0440\u0435\u043A\u043B\u0430\u043C\u0438:\n 1 \u0440\u0430\u0437 \u0432 10
    \u0445\u0432\u0438\u043B\u0438\u043D \u0456 \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438\n
    3 \u0432\u0456\u0434\u0441\u0442\u0440\u043E\u0447\u043A\u0438 \u043D\u0430 \u043A\u0443\u043F\u0456\u0432\u043B\u044E
    \u0441\u043A\u0456\u043D\u0456\u0432. "
